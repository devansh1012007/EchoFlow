# EchoFlow — Laptop media worker environment template
# Copy to .env and fill in real values:   cp .env.laptop.example .env
#
# The laptop connects to VPS services via Tailscale (private network).
# DATABASE_URL, REDIS_BROKER_URL, REDIS_CACHE_URL all point at VPS container IPs.

# --- Django ---
DJANGO_SECRET_KEY=<same-as-vps>
# Must match the VPS DJANGO_SECRET_KEY — signed cookies must verify across services.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.echoflow.in

# --- Database (via Tailscale) ---
DB_NAME=echoflow_db
DB_USER=echoflow
DB_PASSWORD=<same-as-vps>
# VPS db container IP is 172.28.0.4 (set in docker-compose.vps.yml)
DATABASE_URL=postgres://echoflow:<db-password>@172.28.0.4:5432/echoflow_db

# --- Redis (via Tailscale) ---
# VPS redis_broker container IP is 172.28.0.2
# Must match REDIS_BROKER_PASSWORD from the VPS .env (same password)
REDIS_BROKER_PASSWORD=<same-as-vps>
REDIS_BROKER_URL=redis://:<redis-broker-password>@172.28.0.2:6379/0
# VPS redis_cache container IP is 172.28.0.3
REDIS_CACHE_PASSWORD=<same-as-vps>
REDIS_CACHE_URL=redis://:<redis-cache-password>@172.28.0.3:6379/0

# --- Media storage (Cloudflare R2) ---
AWS_ACCESS_KEY_ID=<your-r2-access-key>
AWS_SECRET_ACCESS_KEY=<your-r2-secret>
AWS_STORAGE_BUCKET_NAME=echoflow-media
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_QUERYSTRING_EXPIRE=3600

# --- HLS playback token ---
# Must match the VPS value — Django and the Worker share this secret.
MEDIA_TOKEN_SECRET=<same-as-vps>
MEDIA_TOKEN_TTL_SECONDS=600
# Laptop worker doesn't issue tokens; this is for consistency with VPS.
MEDIA_TOKEN_COOKIE_DOMAIN=.echoflow.in

# --- HuggingFace (required for media image build) ---
HF_TOKEN=<your-hf-token>
HF_HUB_OFFLINE=1
HF_HOME=/home/appuser/.cache/huggingface

# --- Field encryption (must match VPS) ---
FIELD_ENCRYPTION_KEY=<same-as-vps>
# Must match the VPS FIELD_ENCRYPTION_KEY — encrypted DB fields must decrypt correctly.
